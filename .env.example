# Discord Bot Token
# Discord Developer Portal'dan alınır: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Discord Client ID (Application ID)
CLIENT_ID=your_client_id_here

# (Opsiyonel) Test için belirli bir sunucu ID'si
GUILD_ID=your_guild_id_here

# Google Gemini API Key
# Google AI Studio'dan alınır: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
